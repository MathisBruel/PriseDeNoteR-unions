# Clé de chiffrement des secrets et de signature des sessions (obligatoire).
# Générez-la avec : openssl rand -hex 32   — ne la changez plus ensuite.
APP_SECRET_KEY=

# URL publique de l'interface (sert à l'URI de redirection OAuth Google).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Mettre « true » quand l'interface est servie en HTTPS (recommandé hors localhost).
COOKIE_SECURE=false

POSTGRES_PASSWORD=pdn
TIMEZONE=Europe/Paris

# Nombre de réunions enregistrées en parallèle (prévoir ~2 vCPU et 2 Go de RAM par réunion).
MAX_CONCURRENT_MEETINGS=3
